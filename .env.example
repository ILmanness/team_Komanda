# Local development only. Do not commit .env or use this password in production.
POSTGRES_DB=arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# mock starts without a key; compatible uses an external chat/completions API.
AI_PROVIDER=mock
AI_BASE_URL=https://your-provider.example/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# History and private context are removed after completion. Results expire too.
HISTORY_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
# Inactive active sessions are marked abandoned before retention starts.
ACTIVE_SESSION_IDLE_DAYS=30
RETENTION_INTERVAL_SECONDS=3600
