# Local development only. Do not commit .env or use this password in production.
POSTGRES_DB=arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST=localhost
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Required for JWT signing. Replace with your own random secret before starting.
AUTH_SECRET_KEY=replace-with-a-random-secret-before-starting
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mock starts without a key. Cloud.ru example; change URL/model for another compatible API.
AI_PROVIDER=mock
AI_BASE_URL=https://foundation-models.api.cloud.ru/v1
AI_API_KEY=
AI_MODEL=ai-sage/GigaChat3.5-432B-A28B
AI_TIMEOUT_SECONDS=30

# History and private context are removed after completion. Results expire too.
HISTORY_RETENTION_DAYS=7
SESSION_RETENTION_DAYS=30
# Inactive active sessions are marked abandoned before retention starts.
ACTIVE_SESSION_IDLE_DAYS=30
RETENTION_INTERVAL_SECONDS=3600
